<section class="scene scene--evidence_gate span-{{scene.display.span}}">
  <div class="scene__eyebrow">evidence gate</div>
  <h2 class="scene__title">{{scene.content.title}}</h2>
  {{#if scene.data.claims.length}}
  <div class="evidence-table-wrap">
    <table class="evidence-table">
      <thead><tr><th>Claim</th><th>Evidence</th><th>Verdict</th></tr></thead>
      <tbody>
      {{#each scene.data.claims}}
        <tr>
          <td>{{claim}}</td>
          <td>{{join evidence ", "}}</td>
          <td><span class="verdict verdict--{{lower status}}">{{status}}</span></td>
        </tr>
      {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="scene__body markdown-body">{{{scene.body_html}}}</div>
  {{/if}}
</section>
