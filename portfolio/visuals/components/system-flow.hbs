<section class="scene scene--system_flow span-{{scene.display.span}}">
  <div class="scene__eyebrow">composite system view</div>
  <h2 class="scene__title">{{scene.content.title}}</h2>
  <div class="flow-frame">
    <svg class="flow-svg" viewBox="0 0 {{scene.graph.layout.width}} {{scene.graph.layout.height}}" role="img" aria-label="{{scene.content.title}}">
      <defs>
        <marker id="arrow-{{scene.id}}" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L0,6 L9,3 z" class="flow-arrow" />
        </marker>
      </defs>
      {{#each scene.graph.edges}}
      <path d="{{path}}" class="flow-edge" marker-end="url(#arrow-{{../scene.id}})" />
      {{/each}}
      {{#each scene.graph.nodes}}
      <g transform="translate({{layout.x}},{{layout.y}})" class="flow-node">
        <rect width="{{layout.width}}" height="{{layout.height}}" rx="16" ry="16" />
        <text x="{{layout.label_x}}" y="{{layout.label_y}}" text-anchor="middle" dominant-baseline="middle">{{label}}</text>
      </g>
      {{/each}}
    </svg>
  </div>
</section>
