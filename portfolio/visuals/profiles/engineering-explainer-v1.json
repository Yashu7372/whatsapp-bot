{
  "id": "engineering-explainer-v1",
  "template": "portfolio/visuals/templates/responsive-document.hbs",
  "stylesheet": "portfolio/visuals/themes/engineering-explainer.css",
  "components": {
    "hero": "portfolio/visuals/components/hero.hbs",
    "system_flow": "portfolio/visuals/components/system-flow.hbs",
    "evidence_gate": "portfolio/visuals/components/evidence.hbs",
    "default": "portfolio/visuals/components/section.hbs"
  },
  "layout": {
    "graph": {
      "algorithm": "layered",
      "direction": "RIGHT",
      "node_width": 230,
      "node_height": 92,
      "spacing_node_node": 44,
      "spacing_layer": 72,
      "padding": 32
    }
  },
  "tokens": {
    "font_family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "background": "#f5f7fb",
    "surface": "#ffffff",
    "surface_alt": "#eef3f9",
    "ink": "#142033",
    "muted": "#65748a",
    "accent": "#2d63ff",
    "accent_soft": "#e9efff",
    "border": "#d9e1ec",
    "success": "#157347",
    "warning": "#9a6700",
    "danger": "#b42318",
    "shadow": "0 18px 48px rgba(20,32,51,.10)",
    "radius": "22px",
    "page_max_width": "1480px",
    "page_gap": "22px"
  }
}
