# PostgreSQL
POSTGRES_DB=whatsapp_bot
POSTGRES_USER=whatsapp_bot
POSTGRES_PASSWORD=whatsapp_bot
POSTGRES_PORT=5432

# Spring Boot
APP_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=this-is-a-local-dev-secret-change-in-production-min32chars

# WhatsApp local testing
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_ACCESS_TOKEN=local-access-token
WHATSAPP_GRAPH_API_VERSION=v19.0
WHATSAPP_MOCK_SEND_ENABLED=true

# Local Gemma 4 / Ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_KEEP_ALIVE=24h
AI_PROVIDER=OLLAMA
AI_OLLAMA_BASE_URL=http://ollama:11434
AI_OLLAMA_MODEL=gemma4:e2b
AI_TIMEOUT_SECONDS=180

# Local fixed-template renderer
RENDERER_PORT=8090
RENDER_TIMEOUT_SECONDS=240
REEL_RENDER_POLL_INTERVAL_MS=2000
REEL_MAX_ASSET_BYTES=10485760
REEL_DEFAULT_TEMPLATE=DYNAMIC_BOLD
REEL_DEFAULT_VOICE=af_heart

# Optional Kokoro profile: docker compose --profile voice up --build
KOKORO_PORT=8880
KOKORO_LOG_LEVEL=INFO

# Optional live discovery/media providers
YOUTUBE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
GOOGLE_TRENDS_RSS_ENABLED=true

# Upload limits
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB
