# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=whatsapp_bot
POSTGRES_USER=whatsapp_bot
POSTGRES_PASSWORD=whatsapp_bot
POSTGRES_PORT=5432

# ── Port mapping ──────────────────────────────────────────────────────────────
APP_PORT=8080
FRONTEND_PORT=5173

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Keep WHATSAPP_MOCK_SEND_ENABLED=true in dev — messages are logged, not sent
WHATSAPP_VERIFY_TOKEN=dev_verify_token_change_me
WHATSAPP_ACCESS_TOKEN=your_whatsapp_graph_api_token
WHATSAPP_MOCK_SEND_ENABLED=true

# ── AI Provider ───────────────────────────────────────────────────────────────
# Supported values: GEMINI | OPENAI | ANTHROPIC | OLLAMA
AI_PROVIDER=GEMINI
AI_GEMINI_API_KEY=your_google_ai_studio_key
AI_GEMINI_MODEL=gemini-2.5-flash

# Uncomment to use OpenAI instead
# AI_PROVIDER=OPENAI
# AI_OPENAI_API_KEY=sk-...
# AI_OPENAI_MODEL=gpt-4o-mini

# Uncomment to use Anthropic instead
# AI_PROVIDER=ANTHROPIC
# AI_ANTHROPIC_API_KEY=sk-ant-...
# AI_ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_string_at_least_32_characters_long

# ── Optional tuning ───────────────────────────────────────────────────────────
KNOWLEDGE_REBUILD_ON_STARTUP=false
MALWARE_SCAN_ENABLED=false
AI_MEMORY_MAX_MESSAGES=20
WEBHOOK_OUTBOX_POLL_INTERVAL_MS=1000
WEBHOOK_OUTBOX_BATCH_SIZE=5
WEBHOOK_OUTBOX_MAX_RETRIES=3
