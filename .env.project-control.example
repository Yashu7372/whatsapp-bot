# Project Control local Docker stack
PROJECT_CONTROL_POSTGRES_DB=project_control
PROJECT_CONTROL_POSTGRES_USER=project_control
PROJECT_CONTROL_POSTGRES_PASSWORD=change_this_local_password
PROJECT_CONTROL_POSTGRES_PORT=5433
PROJECT_CONTROL_BACKEND_PORT=8080
PROJECT_CONTROL_UI_PORT=5174

# This path is relative to docker-compose.project-control.yml.
# Expected sibling checkout: ../whatsapp-crm/project-control-ui
PROJECT_CONTROL_UI_CONTEXT=../whatsapp-crm/project-control-ui

# Optional bounded reasoning worker. Leave disabled to use evidence-only reviewer briefs.
PROJECT_CONTROL_AI_ENABLED=false
PROJECT_CONTROL_AI_BASE_URL=https://api.openai.com/v1
PROJECT_CONTROL_AI_API_KEY=
PROJECT_CONTROL_AI_MODEL=gpt-5-mini

# Meta WhatsApp Cloud API values from the existing test-number setup.
PROJECT_CONTROL_WHATSAPP_ENABLED=true
WHATSAPP_VERIFY_TOKEN=choose_a_private_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Use the Graph API version configured/tested for your Meta app, for example vXX.X.
WHATSAPP_API_VERSION=
# Strongly recommended: Meta App Secret enables X-Hub-Signature-256 validation.
WHATSAPP_APP_SECRET=

# Bind one WhatsApp test participant to an existing Project Control demo identity.
# inspector@local.demo receives the brief when the workflow reaches Consultant Inspector.
PROJECT_CONTROL_WHATSAPP_USER_EMAIL=inspector@local.demo
# Your WhatsApp recipient/sender number in international format, digits only or with leading +.
PROJECT_CONTROL_WHATSAPP_USER_NUMBER=
PROJECT_CONTROL_WHATSAPP_NOTIFICATION_SCAN_MS=5000
PROJECT_CONTROL_WHATSAPP_NOTIFICATION_INITIAL_DELAY_MS=5000

# Cloudflare named tunnel. Do not commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=
# Documentation/reference only. Configure this hostname on the Cloudflare tunnel route.
CLOUDFLARE_PUBLIC_HOSTNAME=pc-meta.example.com
