# Copy these values into the GitHub Actions secret VPS_ENV_FILE.
# Never commit real secrets.

# PostgreSQL (private Docker network only)
POSTGRES_DB=whatsapp_bot
POSTGRES_USER=whatsapp_bot
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Stable public URLs
PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_APP_BASE_URL=https://app.example.com

# Cloudflare remotely-managed tunnel token
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Authentication
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=604800

# WhatsApp. Keep mock send enabled until a real Meta token is configured.
WHATSAPP_VERIFY_TOKEN=staging_verify_token_change_me
WHATSAPP_ACCESS_TOKEN=staging_mock_access_token
WHATSAPP_MOCK_SEND_ENABLED=true
WHATSAPP_GRAPH_API_VERSION=v19.0

# AI. Blank API key is acceptable if the staging flow does not call AI yet.
AI_PROVIDER=GEMINI
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.5-flash
AI_TEMPERATURE=0.0
AI_TIMEOUT_SECONDS=30
AI_MEMORY_MAX_MESSAGES=20

# Lightweight staging defaults
KNOWLEDGE_REBUILD_ON_STARTUP=false
MALWARE_SCAN_ENABLED=false
DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=6
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB
APP_STORAGE_PROVIDER=local
STORAGE_UPLOAD_TOKEN_TTL_SECONDS=900
