        {
          "name":"1. Get CSRF",
          "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},
          "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('CSRF token returned', function () { pm.response.to.have.status(200); });","const j = pm.response.json();","pm.collectionVariables.set('csrfHeader', j.headerName);","pm.collectionVariables.set('csrfToken', j.token);"]}}]
        },
        {
          "name":"2. Login - Project Admin",
          "request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}","type":"text"},{"key":"Content-Type","value":"application/json","type":"text"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/auth/login"},
          "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeded', function () { pm.response.to.have.status(200); });","const j = pm.response.json();","pm.collectionVariables.set('currentUser', j.email);"]}}]
        },
        {
          "name":"3. Refresh CSRF after login",
          "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},
          "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('CSRF token returned', function () { pm.response.to.have.status(200); });","const j = pm.response.json();","pm.collectionVariables.set('csrfHeader', j.headerName);","pm.collectionVariables.set('csrfToken', j.token);"]}}]
        },
        {
          "name":"4. Load Demo Scenario Manifest",
          "request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/local/demo-scenario"},
          "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Demo manifest loaded', function () { pm.response.to.have.status(200); });","const j = pm.response.json();","['workspaceId','projectId','chwScopeId','clientOrganizationId','contractorOrganizationId','consultantOrganizationId','documentId','revisionId','documentWorkflowDefinitionId','documentWorkflowInstanceId','verificationWorkflowDefinitionId','firstVerificationPackageId','firstVerificationItemId','firstVerificationPackageVersion','contractId','contractItemId'].forEach(k => pm.collectionVariables.set(k, j[k]));","pm.test('Demo begins at clean starting state', function () {","  pm.expect(j.documentWorkflowStatus).to.eql('RUNNING');","  pm.expect(j.firstVerificationPackageStatus).to.eql('DRAFT');","});"]}}]
        }
