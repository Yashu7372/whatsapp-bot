    {
      "name":"01 - Controlled Drawing + AI-Assisted Review",
      "item":[
        {"name":"1. Login - Site Team","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}","type":"text"},{"key":"Content-Type","value":"application/json","type":"text"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{siteEmail}}\",\n  \"password\": \"{{password}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeded', function () { pm.response.to.have.status(200); });"]}}]},
        {"name":"2. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json(); pm.collectionVariables.set('csrfHeader',j.headerName); pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"3. Site Team - Submit controlled drawing workflow","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMPLETE_STEP\",\"actionCode\":\"SUBMIT\",\"targetStepCode\":null,\"comment\":\"Raised by Site Team for controlled review\",\"metadataJson\":\"{}\"}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/actions"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Site submission moves workflow to QCE',function(){pm.response.to.have.status(200);pm.expect(pm.response.json().currentStep.stepCode).to.eql('QCE_VERIFY');});"]}}]},
        {"name":"4. Negative proof - Site Team cannot perform QCE verification","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMPLETE_STEP\",\"actionCode\":\"VERIFY\",\"targetStepCode\":null,\"comment\":\"This must be denied\",\"metadataJson\":\"{}\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/actions"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Wrong actor is denied',function(){pm.response.to.have.status(403);});"]}}]},
        {"name":"5. Login - QCE","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{qceEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"6. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"7. QCE - Reviewer brief","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/assistant/reviewer-brief"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Role-aware reviewer brief returned',function(){pm.response.to.have.status(200);const j=pm.response.json();pm.expect(['EVIDENCE_ONLY','AI_ASSISTED']).to.include(j.reasoningMode);pm.expect(j.document.documentNumber).to.eql('AUR-CRK-MEP-SD-004');pm.expect(j.workflow.currentStepCode).to.eql('QCE_VERIFY');pm.expect(j.evidence).to.not.eql(null);});"]}}]},
        {"name":"8. QCE - Ask bounded assistant what changed","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"question\":\"What changed in this revision and what evidence should I focus on before I verify it?\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/assistant/query"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Assistant answers from authorized context',function(){pm.response.to.have.status(200);const j=pm.response.json();pm.expect(j.answer).to.be.a('string').and.not.empty;pm.expect(['EVIDENCE_ONLY','AI_ASSISTED']).to.include(j.reasoningMode);});"]}}]},
        {"name":"9. QCE - Verify","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMPLETE_STEP\",\"actionCode\":\"VERIFY\",\"targetStepCode\":null,\"comment\":\"QCE verified controlled submission\",\"metadataJson\":\"{}\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/actions"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Moves to QC/DC',function(){pm.response.to.have.status(200);pm.expect(pm.response.json().currentStep.stepCode).to.eql('QC_DC_RECEIVE');});"]}}]},
        {"name":"10. Login - QC/DC","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{qcdcEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"11. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"12. QC/DC - Receive","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMPLETE_STEP\",\"actionCode\":\"RECEIVE\",\"targetStepCode\":null,\"comment\":\"Document control receiving completed\",\"metadataJson\":\"{}\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/actions"}},
        {"name":"13. Login - Consultant Inspector","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{inspectorEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"14. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"15. Inspector - Add review comment","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMMENT\",\"actionCode\":\"COMMENT\",\"targetStepCode\":null,\"comment\":\"Routing revision reviewed against coordinated shaft clearance; field verification remains separate.\",\"metadataJson\":\"{}\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/actions"}},
        {"name":"16. Inspector - Complete technical review","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMPLETE_STEP\",\"actionCode\":\"REVIEW\",\"targetStepCode\":null,\"comment\":\"Technical review complete; forwarded to RE\",\"metadataJson\":\"{}\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/actions"}},
        {"name":"17. Login - Consultant RE","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{reEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"18. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"19. RE - Final approval","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMPLETE_STEP\",\"actionCode\":\"APPROVE\",\"targetStepCode\":null,\"comment\":\"Final controlled drawing approval\",\"metadataJson\":\"{}\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/actions"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Document workflow completed',function(){pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('COMPLETED');});"]}}]},
        {"name":"20. Workflow history - provenance proof","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/workflow-instances/{{documentWorkflowInstanceId}}/history"}}
      ]
    },
    {
      "name":"02 - Verification, Partial Acceptance & Rework",
      "item":[
        {"name":"1. Login - Contractor QS","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{contractorQsEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"2. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"3. Submit WVP-CHW-001 (320 m)","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{firstVerificationPackageVersion}},\"workflowDefinitionId\":\"{{verificationWorkflowDefinitionId}}\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{firstVerificationPackageId}}/submit"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('First verification package submitted',function(){pm.response.to.have.status(200);const j=pm.response.json();pm.expect(j.status).to.eql('SUBMITTED');pm.collectionVariables.set('firstVerificationPackageVersion',j.version);});"]}}]},
        {"name":"4. Load first verification package/workflow","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{firstVerificationPackageId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Verification workflow linked',function(){pm.response.to.have.status(200);const j=pm.response.json();pm.collectionVariables.set('firstVerificationWorkflowInstanceId',j.workflowInstanceId);pm.collectionVariables.set('firstVerificationPackageVersion',j.verificationPackage.version);});"]}}]},
        {"name":"5. Login - Consultant Inspector","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{inspectorEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"6. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"7. Inspector - Complete first field verification workflow","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMPLETE_STEP\",\"actionCode\":\"ACCEPT\",\"targetStepCode\":null,\"comment\":\"Field verification complete; 20 m requires rework\",\"metadataJson\":\"{}\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{firstVerificationWorkflowInstanceId}}/actions"}},
        {"name":"8. Refresh first package version","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{firstVerificationPackageId}}","event":[]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('firstVerificationPackageVersion',pm.response.json().verificationPackage.version);"]}}]},
        {"name":"9. Record 300 m accepted + 20 m rework","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{firstVerificationPackageVersion}},\"itemId\":\"{{firstVerificationItemId}}\",\"actorOrganizationId\":\"{{consultantOrganizationId}}\",\"decision\":\"PARTIALLY_ACCEPTED\",\"acceptedQuantity\":300,\"rejectedQuantity\":20,\"unit\":\"m\",\"comments\":\"300 m accepted; 20 m returned for rework\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{firstVerificationPackageId}}/decisions"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Partial quantity truth recorded',function(){pm.response.to.have.status(200);const j=pm.response.json();pm.collectionVariables.set('firstDecisionId',j.id);});"]}}]},
        {"name":"10. Refresh first package version after item decision","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{firstVerificationPackageId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('firstVerificationPackageVersion',pm.response.json().verificationPackage.version);"]}}]},
        {"name":"11. Close first package as PARTIALLY_ACCEPTED","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{firstVerificationPackageVersion}},\"itemId\":null,\"actorOrganizationId\":\"{{consultantOrganizationId}}\",\"decision\":\"PARTIALLY_ACCEPTED\",\"acceptedQuantity\":null,\"rejectedQuantity\":null,\"unit\":null,\"comments\":\"Partial acceptance recorded; rework remains traceable\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{firstVerificationPackageId}}/decisions"},
        {"name":"12. Create first immutable measurement","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"decisionId\":\"{{firstDecisionId}}\",\"measuredQuantity\":320,\"periodFrom\":\"2026-09-01\",\"periodTo\":\"2026-09-15\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{firstVerificationPackageId}}/measurements"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('firstMeasurementId',j.id);pm.test('300 accepted / 20 rework preserved',function(){pm.expect(Number(j.acceptedQuantity)).to.eql(300);pm.expect(Number(j.rejectedQuantity)).to.eql(20);});"]}}]},
        {"name":"13. Login - Contractor QS","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{contractorQsEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"14. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"15. Create child WVP-CHW-002 for 20 m rework","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"scopeId\":\"{{chwScopeId}}\",\"packageNumber\":\"WVP-CHW-002\",\"subjectType\":\"REWORK_QUANTITY\",\"submittingOrganizationId\":\"{{contractorOrganizationId}}\",\"parentPackageId\":\"{{firstVerificationPackageId}}\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('followUpPackageId',j.id);pm.collectionVariables.set('followUpPackageVersion',j.version);"]}}]},
        {"name":"16. Add 20 m rework item","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{followUpPackageVersion}},\"subjectResourceReference\":\"scope://{{projectId}}/{{chwScopeId}}/CHW-ZB-005\",\"claimedProgress\":null,\"claimedQuantity\":20,\"unit\":\"m\",\"completionStatement\":\"20 m CHW reworked and resubmitted\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}/items"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('followUpItemId',pm.response.json().id);"]}}]},
        {"name":"17. Refresh follow-up package version","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('followUpPackageVersion',pm.response.json().verificationPackage.version);"]}}]},
        {"name":"18. Attach controlled evidence to rework","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{followUpPackageVersion}},\"documentRevisionId\":\"{{revisionId}}\",\"evidenceType\":\"REWORK_COMPLETION_RECORD\",\"visibilityScope\":\"PROJECT_SHARED\",\"required\":true}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}/evidence"},
        {"name":"19. Refresh follow-up package version again","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('followUpPackageVersion',pm.response.json().verificationPackage.version);"]}}]},
        {"name":"20. Submit WVP-CHW-002","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{followUpPackageVersion}},\"workflowDefinitionId\":\"{{verificationWorkflowDefinitionId}}\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}/submit"},
        {"name":"21. Load follow-up verification workflow","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('followUpWorkflowInstanceId',j.workflowInstanceId);pm.collectionVariables.set('followUpPackageVersion',j.verificationPackage.version);"]}}]},
        {"name":"22. Login - Consultant Inspector","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{inspectorEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"23. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"24. Inspector - Accept rework workflow","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"actionType\":\"COMPLETE_STEP\",\"actionCode\":\"ACCEPT\",\"targetStepCode\":null,\"comment\":\"Rework inspected and accepted\",\"metadataJson\":\"{}\"}"},"url":"{{baseUrl}}/api/v1/workflow-instances/{{followUpWorkflowInstanceId}}/actions"},
        {"name":"25. Refresh follow-up version for decision","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('followUpPackageVersion',pm.response.json().verificationPackage.version);"]}}]},
        {"name":"26. Accept remaining 20 m","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{followUpPackageVersion}},\"itemId\":\"{{followUpItemId}}\",\"actorOrganizationId\":\"{{consultantOrganizationId}}\",\"decision\":\"ACCEPTED\",\"acceptedQuantity\":20,\"rejectedQuantity\":0,\"unit\":\"m\",\"comments\":\"Remaining 20 m accepted after rework\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}/decisions","event":[]},
        {"name":"27. Refresh follow-up version after item decision","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('followUpPackageVersion',pm.response.json().verificationPackage.version);"]}}]},
        {"name":"28. Close follow-up package as ACCEPTED","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{followUpPackageVersion}},\"itemId\":null,\"actorOrganizationId\":\"{{consultantOrganizationId}}\",\"decision\":\"ACCEPTED\",\"acceptedQuantity\":null,\"rejectedQuantity\":null,\"unit\":null,\"comments\":\"Follow-up verification accepted\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}/decisions"},
        {"name":"29. Create second immutable measurement","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"decisionId\":\"{{followUpDecisionId}}\",\"measuredQuantity\":20,\"periodFrom\":\"2026-09-16\",\"periodTo\":\"2026-09-20\"}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/verification-packages/{{followUpPackageId}}/measurements"},
        {"name":"30. Measurement ledger - 320 m accepted across two immutable measurements","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/measurements?scopeId={{chwScopeId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Accepted measurement total is 320 m',function(){pm.response.to.have.status(200);const rows=pm.response.json();const total=rows.reduce((s,x)=>s+Number(x.acceptedQuantity||0),0);pm.expect(total).to.eql(320);pm.expect(rows.length).to.eql(2);});"]}}]}
      ]
    },
    {
      "name":"03 - Valuation, IPC, Certification, Payment & Trace",
      "item":[
        {"name":"1. Login - Contractor QS","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{contractorQsEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"2. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"3. Negative proof - arbitrary quantity valuation is rejected","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"contractId\":\"{{contractId}}\",\"contractItemId\":\"{{contractItemId}}\",\"valuationNumber\":\"VAL-INVALID\",\"sourceType\":\"DOCUMENT\",\"sourceReference\":\"manual-value\",\"sourceDocumentRevisionId\":\"{{revisionId}}\",\"measurementId\":null,\"currentValue\":120000,\"retention\":0,\"otherDeductions\":0}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/valuations"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Quantity-rate valuation cannot be typed manually',function(){pm.response.to.have.status(400);});"]}}]},
        {"name":"4. Value first accepted measurement: 300 m x AED 400","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"contractId\":\"{{contractId}}\",\"contractItemId\":\"{{contractItemId}}\",\"valuationNumber\":\"VAL-CHW-300\",\"sourceType\":null,\"sourceReference\":null,\"sourceDocumentRevisionId\":null,\"measurementId\":\"{{firstMeasurementId}}\",\"currentValue\":null,\"retention\":0,\"otherDeductions\":0}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/valuations","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('valuation300Id',j.id);pm.test('300m = AED120k',function(){pm.expect(Number(j.currentValue)).to.eql(120000);});"]}}]},
        {"name":"5. Value follow-up accepted measurement: 20 m x AED 400","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"contractId\":\"{{contractId}}\",\"contractItemId\":\"{{contractItemId}}\",\"valuationNumber\":\"VAL-CHW-20\",\"sourceType\":null,\"sourceReference\":null,\"sourceDocumentRevisionId\":null,\"measurementId\":\"{{followUpMeasurementId}}\",\"currentValue\":null,\"retention\":0,\"otherDeductions\":0}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/valuations","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('valuation20Id',j.id);pm.test('20m = AED8k and cumulative AED128k',function(){pm.expect(Number(j.currentValue)).to.eql(8000);pm.expect(Number(j.cumulativeValue)).to.eql(128000);});"]}}]},
        {"name":"6. Create IPC-005","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"contractId\":\"{{contractId}}\",\"applicationNumber\":\"IPC-005\",\"periodFrom\":\"2026-09-01\",\"periodTo\":\"2026-09-30\",\"dueDate\":\"2026-10-15\",\"sourceDocumentRevisionId\":null}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payment-applications","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('paymentApplicationId',j.id);pm.collectionVariables.set('paymentApplicationVersion',j.version);"]}}]},
        {"name":"7. Add AED 120,000 valuation line","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"valuationLineId\":\"{{valuation300Id}}\",\"claimedValue\":120000}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payment-applications/{{paymentApplicationId}}/lines"},
        {"name":"8. Add AED 8,000 valuation line","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"valuationLineId\":\"{{valuation20Id}}\",\"claimedValue\":8000}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payment-applications/{{paymentApplicationId}}/lines"},
        {"name":"9. Refresh IPC version","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payment-applications/{{paymentApplicationId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('paymentApplicationVersion',j.version);pm.test('IPC claim AED128k',function(){pm.expect(Number(j.claimedAmount)).to.eql(128000);});"]}}]},
        {"name":"10. Submit IPC-005","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{paymentApplicationVersion}}}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payment-applications/{{paymentApplicationId}}/submit"},
        {"name":"11. Login - Client QS","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{clientQsEmail}}\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/api/auth/login"}},
        {"name":"12. Refresh CSRF","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/auth/csrf"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('csrfHeader',j.headerName);pm.collectionVariables.set('csrfToken',j.token);"]}}]},
        {"name":"13. Refresh submitted IPC version","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payment-applications/{{paymentApplicationId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('paymentApplicationVersion',pm.response.json().version);"]}}]},
        {"name":"14. Certify AED 124,000","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"version\":{{paymentApplicationVersion}},\"lines\":[{\"valuationLineId\":\"{{valuation300Id}}\",\"certifiedValue\":116000,\"reason\":\"AED 4,000 contractual adjustment\"},{\"valuationLineId\":\"{{valuation20Id}}\",\"certifiedValue\":8000,\"reason\":\"Fully certified\"}]}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payment-applications/{{paymentApplicationId}}/certify","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Certified AED124k',function(){pm.response.to.have.status(200);pm.expect(Number(pm.response.json().certifiedAmount)).to.eql(124000);});"]}}]},
        {"name":"15. Record AED 124,000 payment","request":{"method":"POST","header":[{"key":"{{csrfHeader}}","value":"{{csrfToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"paymentApplicationId\":\"{{paymentApplicationId}}\",\"paymentReference\":\"PAY-005\",\"amount\":124000,\"paidAt\":\"2026-10-20T10:00:00Z\",\"sourceDocumentRevisionId\":null}"},"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payments","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const j=pm.response.json();pm.collectionVariables.set('paymentId',j.id);pm.test('AED124k payment recorded',function(){pm.expect(Number(j.amount)).to.eql(124000);});"]}}]},
        {"name":"16. FINAL PROOF - Payment reverse trace","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/payments/{{paymentId}}/trace"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Typed reverse trace is complete',function(){pm.response.to.have.status(200);const j=pm.response.json();pm.expect(j.lines.length).to.eql(2);j.lines.forEach(line=>{pm.expect(line.verificationMappingStatus).to.eql('ACCEPTED_MEASUREMENT_TYPED_TRACE_COMPLETE');pm.expect(line.measurementId).to.not.eql(null);pm.expect(line.verificationTrace.evidence.length).to.be.above(0);pm.expect(line.verificationTrace.decisions.length).to.be.above(0);});});"]}}]},
        {"name":"17. Contract commercial summary","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/v1/projects/{{projectId}}/contracts/{{contractId}}/commercial-summary"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Commercial truth reconciles',function(){pm.response.to.have.status(200);const j=pm.response.json();pm.expect(Number(j.valuedToDate)).to.eql(128000);pm.expect(Number(j.claimedToDate)).to.eql(128000);pm.expect(Number(j.certifiedToDate)).to.eql(124000);pm.expect(Number(j.paidToDate)).to.eql(124000);pm.expect(Number(j.outstandingCertified)).to.eql(0);});"]}}]}
      ]
    }
  ]
}